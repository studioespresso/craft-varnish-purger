{
  "name": "studioespresso/craft-varnish-purger",
  "description": "Tag-based Varnish purging for Craft CMS: tracks the elements and queries used on each page and purges them on save.",
  "version": "6.0.0-beta.01",
  "type": "craft-plugin",
  "license": "MIT",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "varnish",
    "cache"
  ],
  "authors": [
    {
      "name": "Studio Espresso",
      "homepage": "https://www.studioespresso.co"
    }
  ],
  "require": {
    "craftcms/cms": "^6.0.0-alpha.8"
  },
  "require-dev": {
    "larastan/larastan": "^3.12",
    "laravel/pint": "^1.27",
    "orchestra/testbench": "^11.0"
  },
  "minimum-stability": "alpha",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "studioespresso\\varnish\\": "src/"
    }
  },
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G",
    "ci": "pint && phpstan --memory-limit=1G",
    "test": "phpunit"
  },
  "extra": {
    "name": "Varnish Purger",
    "handle": "varnish",
    "class": "studioespresso\\varnish\\Varnish",
    "hasCpSettings": true,
    "documentationUrl": "https://github.com/studioespresso/craft-varnish-purger/blob/main/README.md"
  },
  "support": {
    "docs": "https://github.com/studioespresso/craft-varnish-purger/blob/main/README.md",
    "issues": "https://github.com/studioespresso/craft-varnish-purger/issues"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true
    }
  }
}
